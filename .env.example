PORT=4173

# Google Sheets inventory source.
# Option A: publish the Productos sheet as CSV and paste the URL here.
GOOGLE_SHEET_CSV_URL=

# Option B: use a public Google Sheet ID and optional gid.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0

# n8n webhooks. Leave empty during local tests to simulate success.
N8N_ORDER_WEBHOOK_URL=
N8N_QUOTE_WEBHOOK_URL=

# Optional fallback payment link while n8n/payment provider is not ready.
PAYMENT_CHECKOUT_URL=

# Simple PayPal payment receiver for the fallback PayPal button.
PAYPAL_RECEIVER_EMAIL=info@zoi.ec

# Google Identity Services. Create this in Google Cloud Console for production.
GOOGLE_CLIENT_ID=
